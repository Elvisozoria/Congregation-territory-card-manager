rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(congId) {
      return request.auth != null && getUserData().congregationId == congId;
    }

    function isAdminOf(congId) {
      return isMemberOf(congId) && getUserData().role == 'admin';
    }

    function isConductorOf(congId) {
      return isMemberOf(congId) && getUserData().role == 'conductor';
    }

    function isPublisherOf(congId) {
      return isMemberOf(congId) && getUserData().role == 'publisher';
    }

    // Admin o conductor (rol con lectura general)
    function isStaffOf(congId) {
      return isAdminOf(congId) || isConductorOf(congId);
    }

    // Users collection
    match /users/{userId} {
      // Una persona puede llevar varias congregaciones. `memberships` es el mapa
      // {congregationId: rol} de las que son suyas, y congregationId/role son
      // simplemente la ACTIVA. Todo lo demas de estas reglas sigue mirando la
      // activa, asi que no cambia.
      //
      // La parte delicada es que el propio usuario escribe su memberships. Para
      // que no pueda colarse en una congregacion ajena, cada forma de tocar ese
      // mapa se valida por separado y ninguna acepta una congregacion que no
      // haya creado el.
      function ownChanges() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function oldMemberships() {
        return resource.data.get('memberships', {});
      }
      function membershipsChanged() {
        return request.resource.data.memberships.diff(oldMemberships()).affectedKeys();
      }

      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can only create their OWN profile (registration flow)
      allow create: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null && request.auth.uid == userId && (
        // (a) Cambios corrientes: no tocan rol, congregacion activa ni membresias.
        !ownChanges().hasAny(['role', 'congregationId', 'memberships'])

        // (b) Relleno inicial: un perfil viejo estrena memberships con la unica
        //     congregacion que ya tenia, y con el rol que ya tenia.
        || (ownChanges().hasOnly(['memberships'])
            && membershipsChanged().hasOnly([resource.data.congregationId])
            && request.resource.data.memberships[resource.data.congregationId] == resource.data.role)

        // (c) Cambiar de congregacion activa: solo a una que ya sea suya, y con
        //     el rol que ahi tiene. El mapa de membresias no se toca.
        || (ownChanges().hasOnly(['role', 'congregationId'])
            && oldMemberships()[request.resource.data.congregationId] == request.resource.data.role)

        // (d) Crear una congregacion nueva: se anade UNA membresia y tiene que
        //     ser una congregacion cuyo createdBy es este mismo usuario.
        || (ownChanges().hasOnly(['role', 'congregationId', 'memberships'])
            && membershipsChanged().hasOnly([request.resource.data.congregationId])
            && request.resource.data.memberships[request.resource.data.congregationId] == 'admin'
            && request.resource.data.role == 'admin'
            && get(/databases/$(database)/documents/congregations/$(request.resource.data.congregationId)).data.createdBy == request.auth.uid)
      );

      // Admins can read users in their congregation
      allow read: if request.auth != null
        && resource.data.congregationId == getUserData().congregationId
        && getUserData().role == 'admin';

      // Admins can create users in their congregation (for the secondary-app pattern)
      allow create: if request.auth != null
        && getUserData().role == 'admin'
        && request.resource.data.congregationId == getUserData().congregationId;

      // Admins can update users in their congregation (e.g., change role).
      //
      // Nunca sobre su PROPIO perfil: para uno mismo, `resource.data.congregationId
      // == getUserData().congregationId` siempre se cumple, asi que esta regla le
      // dejaba a cualquier admin cambiarse su congregacion y su rol a lo que
      // quisiera, saltandose las condiciones de arriba. El perfil propio se rige
      // solo por el bloque anterior.
      //
      // De las membresias ajenas solo pueden tocar la de su propia congregacion:
      // si no, un admin podria meter a alguien en una congregacion ajena.
      allow update: if request.auth != null
        && request.auth.uid != userId
        && resource.data.congregationId == getUserData().congregationId
        && getUserData().role == 'admin'
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberships'])
            || request.resource.data.memberships.diff(resource.data.get('memberships', {}))
                .affectedKeys().hasOnly([getUserData().congregationId]));

      // Conductor / publisher pueden leer otros perfiles de su congregación
      // (necesario para mostrar nombres en historial / dropdown)
      allow read: if request.auth != null
        && resource.data.congregationId == getUserData().congregationId;
    }

    // Invites (for Google auth invite flow)
    match /invites/{inviteId} {
      // Any authenticated user can read invites (to check their own email)
      allow read: if request.auth != null;
      // Only admins can create invites
      allow create: if request.auth != null && getUserData().role == 'admin';
      // Users can delete invites (consumed on sign-in)
      allow delete: if request.auth != null;
    }

    // Lookup table for public territory links (anyone can read by publicId)
    match /publicLinks/{linkId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Congregations
    match /congregations/{congId} {
      // Miembros leen todo; visitantes anónimos leen si la congregación tiene publicId
      allow read: if isMemberOf(congId) || resource.data.publicId != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdminOf(congId);

      // Territories
      match /territories/{terId} {
        // Miembros leen siempre; visitantes anónimos leen si el territorio tiene publicId
        allow read: if isMemberOf(congId) || resource.data.publicId != null;
        // Solo admin crea/edita/borra (incluye polígono, notas, landmarks, blocks, cardZoom)
        allow create: if isAdminOf(congId);
        allow update: if isAdminOf(congId);
        allow delete: if isAdminOf(congId);
      }

      // History
      match /history/{histId} {
        allow read: if isStaffOf(congId)
          || (isPublisherOf(congId) && resource.data.assignedToUid == request.auth.uid);

        // Crear asignaciones: solo admin
        allow create: if isAdminOf(congId);

        // Actualizar: admin cualquier cosa; conductor/publisher solo su propia entrada
        // y solo pueden cambiar status/endDate/notes (no person, no tipo, no asignación).
        // notifyPending va en la lista porque cerrar una asignación levanta la
        // bandera que recoge el notificador; los sellos notifiedAt /
        // completionNotifiedAt no, esos solo los escribe el service account.
        allow update: if isAdminOf(congId)
          || (isMemberOf(congId)
              && resource.data.assignedToUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'endDate', 'notes', 'notifyPending']));

        // Borrar: solo admin
        allow delete: if isAdminOf(congId);
      }

      // Global Landmarks — solo admin escribe
      match /globalLandmarks/{lmId} {
        allow read: if isMemberOf(congId);
        allow create, update, delete: if isAdminOf(congId);
      }
    }
  }
}
